{
  "name": "dish",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "DISH \u2014 good food, less thinking. Mobile-first meal planning PWA.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "seed:sql": "node scripts/build-seed.mjs",
    "icons": "node scripts/build-icons.mjs",
    "stack:up": "bash scripts/local-stack.sh up",
    "stack:down": "bash scripts/local-stack.sh down"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.106.0",
    "dexie": "^4.4.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.7",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "workbox-window": "^7.4.1"
  }
}
