# ---- Browser (public) — safe to expose ----
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional: set to "true" if Google OAuth is enabled in your Supabase project
VITE_ENABLE_GOOGLE_AUTH=false
# Optional: VAPID public key for Web Push (see PWA_OFFLINE.md)
VITE_VAPID_PUBLIC_KEY=

# ---- Server only — NEVER prefix with VITE_, never commit real values ----
# Set these as Supabase Edge Function secrets: `supabase secrets set KEY=value`
SUPABASE_SERVICE_ROLE_KEY=
AI_PROVIDER=            # anthropic | (empty = AI disabled; the built-in planner still works)
AI_API_KEY=
AI_MODEL_TEXT=          # default: claude-opus-5-5
AI_MODEL_VISION=        # default: claude-opus-5-5
# Web Push reminders (optional) — generate with `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
AI_RATE_LIMIT_PER_HOUR=30
APP_BASE_URL=
