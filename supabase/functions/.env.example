# Copy to supabase/functions/.env for local functions (never commit the real file).
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL_TEXT=claude-opus-5-5
AI_MODEL_VISION=claude-opus-5-5
AI_RATE_LIMIT_PER_HOUR=30
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Catalogue image generation (admin-only). Local stack defaults to IMAGE_PROVIDER=mock.
IMAGE_PROVIDER=openai
IMAGE_API_KEY=
IMAGE_MODEL_STANDARD=gpt-image-2.5-flare
IMAGE_MODEL_FEATURED=gpt-image-2.5-sunburst
IMAGE_DAILY_LIMIT=40
